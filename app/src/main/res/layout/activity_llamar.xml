<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".vista.LlamarActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/volver"
        app:navigationIcon="@drawable/ic_atras"
        app:title="@string/llamar"
        app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgFoto"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="?attr/colorPrimaryContainer"
            android:contentDescription="@string/foto_contacto"
            android:scaleType="fitCenter"
            app:shapeAppearanceOverlay="@style/FormaCircular" />

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="José de Jesús Sarmiento" />

        <TextView
            android:id="@+id/txtTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.DisplaySmall"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            tools:text="+504 9976-5645" />

        <TextView
            android:id="@+id/txtPais"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/fondo_etiqueta"
            android:backgroundTint="?attr/colorSecondaryContainer"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSecondaryContainer"
            tools:text="Honduras (+504)" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLlamar"
            style="@style/Widget.Material3.FloatingActionButton.Large.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="56dp"
            android:contentDescription="@string/llamar"
            app:backgroundTint="@color/alerta_exito"
            app:srcCompat="@drawable/ic_llamar"
            app:tint="@color/sobre_alerta" />
    </LinearLayout>
</LinearLayout>
