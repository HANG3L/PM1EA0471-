<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgFoto"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/colorPrimaryContainer"
                android:contentDescription="@string/foto_contacto"
                android:padding="15dp"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/FormaCircular"
                app:srcCompat="@drawable/ic_persona"
                app:tint="?attr/colorOnPrimaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Nombre del contacto" />

                <TextView
                    android:id="@+id/txtTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="9876-5432" />

                <TextView
                    android:id="@+id/txtPais"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/fondo_etiqueta"
                    android:backgroundTint="?attr/colorSecondaryContainer"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    tools:text="Honduras (+504)" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Nota del contacto" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- Acciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLlamar"
                style="@style/BotonAccion"
                android:text="@string/llamar"
                app:icon="@drawable/ic_llamar" />

            <Button
                android:id="@+id/btnCompartir"
                style="@style/BotonAccion"
                android:text="@string/compartir"
                app:icon="@drawable/ic_compartir" />

            <Button
                android:id="@+id/btnVerFoto"
                style="@style/BotonAccion"
                android:text="@string/foto"
                app:icon="@drawable/ic_imagen" />

            <Button
                android:id="@+id/btnEditar"
                style="@style/BotonAccion"
                android:text="@string/editar"
                app:icon="@drawable/ic_editar" />

            <Button
                android:id="@+id/btnEliminar"
                style="@style/BotonAccion"
                android:text="@string/eliminar"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_eliminar"
                app:iconTint="?attr/colorError" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
